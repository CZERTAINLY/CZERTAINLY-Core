{
  "type": "object",
  "required": ["sequence"],
  "properties": {
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["tagged"],
        "properties": {
          "tagged": {
            "type": "object",
            "required": ["tagNo", "explicit", "value"],
            "properties": {
              "tagNo": { "enum": [0, 1] },
              "explicit": { "const": false },
              "value": { "$ref": "#/$defs/generalSubtrees" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "generalSubtrees": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generalSubtree" }
        }
      }
    },
    "generalSubtree": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "object",
              "required": ["tagged"],
              "properties": {
                "tagged": {
                  "type": "object",
                  "required": ["tagNo"],
                  "properties": { "tagNo": { "type": "integer", "minimum": 0, "maximum": 8 } }
                }
              }
            }
          ]
        }
      }
    }
  }
}
